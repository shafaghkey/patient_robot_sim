<?xml version="1.0" ?>
<robot name="table.urdf">
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <link name="baseLink">
    <contact>
      <lateral_friction value="1.0"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value=".0"/>
       <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.99"/>
      <geometry>
				<mesh filename="table.obj" scale="0.5 0.5 0.05"/>
      </geometry>
	  <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.99"/>
      <geometry>
	 	<box size="0.5 0.5 0.05"/>
      </geometry>
    </collision>
	<visual>
      <origin rpy="0 0 0" xyz="-0.15 -0.15 0.5"/>
      <geometry>
	    <mesh filename="table.obj" scale="0.08 0.08 1"/>
      </geometry>
	  <material name="white"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.15 0.15 0.5"/>
      <geometry>
        <mesh filename="table.obj" scale="0.08 0.08 1"/>
      </geometry>
	  <material name="white"/>
	  </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.15 -0.15 0.5"/>
      <geometry>
        <mesh filename="table.obj" scale="0.08 0.08 1"/>
      </geometry>
	  <material name="white"/>
	  </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.15 0.15 0.5"/>
      <geometry>
        <mesh filename="table.obj" scale="0.08 0.08 1"/>
      </geometry>
	  <material name="white"/>
    </visual>
  </link>
</robot>


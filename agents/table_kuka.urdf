<?xml version="1.0" ?>
<robot name="table.urdf">
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <link name="baseLink">
    <contact>
      <lateral_friction value="1.0"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value=".0"/>
       <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.6"/>
      <geometry>
				<mesh filename="table.obj" scale="0.35 0.35 0.05"/>
      </geometry>
	  <material name="gray"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.6"/>
      <geometry>
	 	<box size="0.35 0.35 0.05"/>
      </geometry>
    </collision>
	<visual>
      <origin rpy="0 0 0" xyz="-0.12 -0.12 0.275"/>
      <geometry>
	    <mesh filename="table.obj" scale="0.08 0.08 0.7"/>
      </geometry>
	  <material name="gray"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.12 0.12 0.275"/>
      <geometry>
        <mesh filename="table.obj" scale="0.08 0.08 0.7"/>
      </geometry>
	  <material name="gray"/>
	  </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.12 -0.12 0.275"/>
      <geometry>
        <mesh filename="table.obj" scale="0.08 0.08 0.7"/>
      </geometry>
	  <material name="gray"/>
	  </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.12 0.12 0.275"/>
      <geometry>
        <mesh filename="table.obj" scale="0.08 0.08 0.7"/>
      </geometry>
	  <material name="gray"/>
    </visual>
  </link>
</robot>

